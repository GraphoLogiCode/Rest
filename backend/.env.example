# Copy to .env and fill in. Never commit .env.

# Your Supabase project URL. Tokens must be issued by <SUPABASE_URL>/auth/v1.
SUPABASE_URL=https://your-project-ref.supabase.co

# Only for projects still signing tokens with the legacy shared secret (HS256).
# Leave empty when the project uses asymmetric signing keys.
SUPABASE_JWT_SECRET=

# Postgres connection string for the Supabase database. Keep it on the server.
# Leave empty to run with in-memory storage that is lost on restart.
DATABASE_URL=

# Browser origins allowed to call the API, comma separated.
CORS_ORIGINS=http://127.0.0.1:5173

# Private AWS model worker (leave BOTH unset to disable cloud illustrations).
# MODEL_SERVICE_URL=http://gpu:8767
# MODEL_SERVICE_TOKEN=generate-a-random-token-at-least-32-characters-long

# Optional absolute path to reviewed catalog JSON. Candidates are never loaded.
# REST_CATALOG_PATH=/app/catalog/products.json
