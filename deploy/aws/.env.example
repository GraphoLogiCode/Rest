AWS_REGION=us-east-2
# Generate locally with: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
MODEL_SERVICE_TOKEN=
SUPABASE_URL=
# Pooler/direct connection URL; require TLS, e.g. append ?sslmode=require.
DATABASE_URL=
# Only legacy HS256 projects need this; JWKS is used for asymmetric signing keys.
SUPABASE_JWT_SECRET=
CORS_ORIGINS=https://your-rest-app.example
REST_MODEL_DIR=/srv/rest/models
REST_JOB_DIR=/srv/rest/jobs
