{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOnlySourceArchive",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": "arn:aws:s3:::rest-pilot-source-620214493890-us-east-2/source.zip"
    },
    {
      "Sid": "InspectSourceBucket",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:GetBucketAcl"
      ],
      "Resource": "arn:aws:s3:::rest-pilot-source-620214493890-us-east-2"
    },
    {
      "Sid": "EcrRegistryAuthentication",
      "Effect": "Allow",
      "Action": [
        "ecr:GetAuthorizationToken"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PushOnlyAppRepository",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:PutImage",
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer"
      ],
      "Resource": "arn:aws:ecr:us-east-2:620214493890:repository/rest-pilot/app"
    },
    {
      "Sid": "WriteOnlyBuildLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:us-east-2:620214493890:log-group:/rest-pilot/build:log-stream:*"
    }
  ]
}
