{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EcrRegistryAuthentication",
      "Effect": "Allow",
      "Action": [
        "ecr:GetAuthorizationToken"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PullOnlyAppImage",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer",
        "ecr:BatchCheckLayerAvailability"
      ],
      "Resource": "arn:aws:ecr:us-east-2:620214493890:repository/rest-pilot/app"
    },
    {
      "Sid": "WriteOnlyAppLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:us-east-2:620214493890:log-group:/rest-pilot/app:log-stream:*"
    },
    {
      "Sid": "ReadOnlyDatabaseConnection",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue"
      ],
      "Resource": "arn:aws:secretsmanager:us-east-2:620214493890:secret:rest-pilot/database-url-??????"
    }
  ]
}
