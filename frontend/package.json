{
  "name": "rest-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:phone": "vite --mode phone --host 0.0.0.0 --port 5174 --strictPort",
    "dev:phone-model": "vite --mode phone-model --host 0.0.0.0 --port 5175 --strictPort",
    "build": "tsc -b && vite build",
